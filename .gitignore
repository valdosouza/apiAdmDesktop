# Node modules
node_modules/

# Environment files (keep example files tracked)
.env
.env.*
!.env.example

# Application config overrides (local)
app/config/db.config.js
app/config/*.local.js

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Runtime data
pids/
*.pid

# OS files
.DS_Store
Thumbs.db
desktop.ini

# IDE / Editor
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln

# Build / coverage
dist/
build/
coverage/
.nyc_output/
lib/

# Temporary / swap
*.tmp
*.temp
*.bak

# Certificates and keys
*.key
*.pem
*.p12
*.pfx
*.jks
*.crt
*.cert

# Database files (local dev)
*.sqlite
*.sqlite3
*.db

# User uploads (do not store large or user data in VCS)
public/uploads/

# Node REPL history
.node_repl_history

# Tooling / credentials
.aws/
*.credentials
*.envrc
*.secret
secrets/
.npmrc

# Config local overrides
*.local.js
*.local.json
*.local.ts

# Terraform state
.terraform/

# Misc
.cache/
__pycache__/
.grunt/
.sass-cache/

# Windows
Thumbs.db:encryptable
$RECYCLE.BIN/

# Vim / Emacs swap
*.swp
*.swo
*~
\#*\#

# Uploads / user content (binarios nao devem ser versionados)
public/uploads/**
!public/uploads/.gitkeep